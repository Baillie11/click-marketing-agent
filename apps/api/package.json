{
  "name": "@click/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "dotenv -e ../../.env -- node dist/src/server.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- prisma db seed"
  },
  "dependencies": {
    "@click/shared": "*",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "6.12.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.1.2",
    "fastify": "^5.6.2",
    "nodemailer": "^10.1.7",
    "openai": "^6.10.0",
    "pino-pretty": "^13.1.3",
    "playwright-core": "^1.55.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "dotenv-cli": "^8.0.0",
    "prisma": "6.12.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "optionalDependencies": {
    "argon2": "^0.45.2"
  }
}
