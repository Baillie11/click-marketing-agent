NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=mysql://click:click@localhost:3306/click_marketing_agent
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
APP_URL=http://localhost:5173
# Required in production for password recovery and user invitations.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Click Marketing Agent <no-reply@example.com>
PASSWORD_RESET_EXPIRES_MINUTES=60
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
LEAD_DISCOVERY_CRON_SECRET=replace-with-a-random-secret-at-least-32-characters
# Required before connecting a CMS. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTOR_ENCRYPTION_KEY=
CRAWLER_MAX_PAGES=50
CRAWLER_TIMEOUT_MS=10000
VISUAL_AUDIT_MAX_PAGES=10
# Optional. Standard Chrome and Edge locations are detected automatically on Windows.
BROWSER_EXECUTABLE_PATH=
